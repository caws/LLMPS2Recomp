 void GS::latchHostPresentationFrame()
 {
+    // Mark that a presentation latch is waiting so the EE thread's GIF hot path yields the
+    // state mutex at a packet boundary (see processGIFPacket); without this the latch starves
+    // behind the back-to-back per-packet re-acquisitions and the window never updates.
+    m_presentWaiters.fetch_add(1u, std::memory_order_acq_rel);
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    m_presentWaiters.fetch_sub(1u, std::memory_order_acq_rel);
     latchHostPresentationFrameUnlocked();
 }
 

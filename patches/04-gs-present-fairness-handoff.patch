 void GS::processGIFPacket(const uint8_t *data, uint32_t sizeBytes)
 {
+    // Present-fairness handoff: if the UI thread's presentation latch is waiting on
+    // m_stateMutex, pause at this packet boundary so it can win the mutex (bounded, in case
+    // this thread already holds the recursive mutex further up the stack).
+    for (int i = 0; i < 40 && m_presentWaiters.load(std::memory_order_acquire) != 0u; ++i)
+    {
+        std::this_thread::sleep_for(std::chrono::microseconds(50));
+    }
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
     if (!data || sizeBytes < 16 || !m_vram)
         return;

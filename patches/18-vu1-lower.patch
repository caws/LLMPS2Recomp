+// ============================================================================
+// PS2X_VU1_KICKCENSUS=<N> (default 0 = OFF): census EVERY XGKICK, not only runaways.
+// Diagnostic only -- reads nothing, changes nothing, submits nothing.
+//
+// WHY (cycle 90): every piece of XGKICK evidence we have ever had comes from the
+// "[VU1:xgkick] DROP" dump, which is sampled CONDITIONED ON FAILURE ("first 20, then every
+// 1000th" -- of the DROPS, not of the kicks). That population cannot answer the questions the
+// render frontier actually needs:
+//   - what fraction of kicks SUCCEED?
+//   - what does a SUCCESSFUL packet's first tag look like?
+//   - is `nloop == 0` a level-era fault, or simply what this microprogram always emits?
+// Reading the failure-conditioned sample as if it were a rate produced a wrong model
+// ("73% of packets are empty" -- it was 73% of *failures*, and the same signature dominates
+// the BOOT era, where the picture is correct).
+//
+// Every sampled line therefore prints BOTH the sampled kick's own first tag AND the running
+// aggregate over ALL kicks, so a per-sample observation can never again be quoted as a rate.
+// `nreg` is printed RAW: nreg==0 means 16 registers to the GIF, and is not an error.
+// ============================================================================
+namespace
+{
+    struct Vu1KickCensus
+    {
+        unsigned long long kicks = 0ull;
+        unsigned long long submitted = 0ull, dropped = 0ull, zeroByte = 0ull;
+        unsigned long long nloop0 = 0ull, nloopSmall = 0ull, nloopHuge = 0ull;
+        unsigned long long flg[4] = {0ull, 0ull, 0ull, 0ull};
+    };
+
+    int ps2xKickCensusEvery()
+    {
+        static const int s_every = []
+        {
+            const char *e = std::getenv("PS2X_VU1_KICKCENSUS");
+            return (e != nullptr && e[0] != '\0') ? std::atoi(e) : 0;
+        }();
+        return s_every;
+    }
+
+    // PER-VU counters. VU0 and VU1 share this interpreter class, so one shared counter lets
+    // VU0's boot-era invocations eat the first-20 window (that exact bias produced a retracted
+    // claim in cycle 89). Index by buffer size: 4KB = VU0, 16KB = VU1.
+    Vu1KickCensus &ps2xKickCensusFor(uint32_t dataSize)
+    {
+        static Vu1KickCensus s_c[2];
+        return s_c[(dataSize <= 4096u) ? 0 : 1];
+    }
+
+    void ps2xKickCensusRecord(uint32_t dataSize, const char *outcome, uint64_t firstTag,
+                              bool haveTag, uint32_t totalBytes, uint32_t addr, int iters)
+    {
+        const int every = ps2xKickCensusEvery();
+        if (every <= 0)
+            return;
+
+        Vu1KickCensus &c = ps2xKickCensusFor(dataSize);
+        const int vu = (dataSize <= 4096u) ? 0 : 1;
+        ++c.kicks;
+        if (outcome[0] == 'S')
+            ++c.submitted;
+        else if (outcome[0] == 'D')
+            ++c.dropped;
+        else
+            ++c.zeroByte;
+
+        uint32_t nloop = 0u, eop = 0u, pre = 0u, prim = 0u, flg = 0u, nreg = 0u;
+        if (haveTag)
+        {
+            nloop = (uint32_t)(firstTag & 0x7FFFull);
+            eop = (uint32_t)((firstTag >> 15) & 0x1ull);
+            pre = (uint32_t)((firstTag >> 46) & 0x1ull);
+            prim = (uint32_t)((firstTag >> 47) & 0x7FFull);
+            flg = (uint32_t)((firstTag >> 58) & 0x3ull);
+            nreg = (uint32_t)((firstTag >> 60) & 0xFull);
+            if (nloop == 0u)
+                ++c.nloop0;
+            else if (nloop <= 64u)
+                ++c.nloopSmall;
+            else
+                ++c.nloopHuge;
+            ++c.flg[flg];
+        }
+
+        if (c.kicks <= 20ull || (c.kicks % (unsigned long long)every) == 0ull)
+        {
+            std::fprintf(stderr,
+                         "[VU1:kickcensus] vu%d #%llu %s addr=%u bytes=%u iters=%d | tag: "
+                         "nloop=%u eop=%u pre=%u prim=%u flg=%u nreg=%u | ALL %llu kicks: "
+                         "sub=%llu drop=%llu zero=%llu | nloop0=%llu small=%llu huge=%llu | "
+                         "flg=%llu/%llu/%llu/%llu\n",
+                         vu, (unsigned long long)c.kicks, outcome, addr, totalBytes, iters,
+                         nloop, eop, pre, prim, flg, nreg,
+                         (unsigned long long)c.kicks, (unsigned long long)c.submitted,
+                         (unsigned long long)c.dropped, (unsigned long long)c.zeroByte,
+                         (unsigned long long)c.nloop0, (unsigned long long)c.nloopSmall,
+                         (unsigned long long)c.nloopHuge,
+                         (unsigned long long)c.flg[0], (unsigned long long)c.flg[1],
+                         (unsigned long long)c.flg[2], (unsigned long long)c.flg[3]);
+        }
+    }
+
+    // ========================================================================
+    // PS2X_VU1_FLAGCENSUS=<N> (default 0 = OFF): census the VU FLAG PIPELINE against the
+    // `nloop` each XGKICK emits.  Cycle 91 item (a).  Diagnostic only.
+    //
+    // WHY: cont.144 localised the failure to a structurally perfect GIF tag carrying
+    // `nloop=0` with real vertex data sitting right behind it -- the geometry is written and
+    // only the COUNT is missing.  A microprogram builds that count by testing a flag register
+    // (clip / MAC / status) and branching, so the question is which flag op the microprogram
+    // consults and what it reads.  This counts every flag op BY RAW OPCODE (so the numbers are
+    // independent of which architectural op we map that opcode to) and attributes the ops
+    // executed since the previous kick to that kick's bucket.
+    //
+    // Two buckets, both censused over ALL kicks: [0] first-tag nloop==0 (the failure) and
+    // [1] nloop>0 (the built-in known-good control in the same run).  Comparing the two
+    // populations inside one run is what keeps this from being another failure-conditioned
+    // sample (standing rule 25).
+    //
+    // PS2X_VU1_FLAGCENSUS_ADDR=<n> (default 8272) additionally counts, per bucket, the kicks
+    // at the one VU1 address cont.144 pinned (522 of the sampled runaways kick there).
+    // ========================================================================
+    enum Vu1FlagOp
+    {
+        FOP_FCEQ = 0, FOP_FCSET, FOP_FCAND, FOP_FCOR,
+        FOP_FSEQ, FOP_FSSET, FOP_FSAND, FOP_FSOR,
+        FOP_FMEQ, FOP_FMAND, FOP_FMOR, FOP_FCGET,
+        FOP_COUNT
+    };
+
+    // Named for the PCSX2-correct meaning of each RAW OPCODE (VUops.cpp `_LOWER_OPCODE[]`):
+    // 0x10-0x13 FCEQ/FCSET/FCAND/FCOR, 0x14-0x17 FSEQ/FSSET/FSAND/FSOR,
+    // 0x18 FMEQ, 0x1A FMAND, 0x1B FMOR, 0x1C FCGET.
+    const char *const kVu1FlagOpName[FOP_COUNT] = {
+        "fceq", "fcset", "fcand", "fcor",
+        "fseq", "fsset", "fsand", "fsor",
+        "fmeq", "fmand", "fmor", "fcget"};
+
+    struct Vu1FlagBucket
+    {
+        unsigned long long kicks = 0ull;
+        unsigned long long atAddr = 0ull;
+        unsigned long long ops[FOP_COUNT] = {};
+        unsigned long long clipZero = 0ull, clipFull = 0ull, clipOther = 0ull;
+        unsigned long long macNonZero = 0ull, statusNonZero = 0ull;
+        uint32_t lastClip = 0u, lastMac = 0u, lastStatus = 0u;
+    };
+
+    struct Vu1FlagCensus
+    {
+        unsigned long long ops[FOP_COUNT] = {};
+        unsigned long long opsAtLastKick[FOP_COUNT] = {};
+        unsigned long long unkLower = 0ull, unkLower1 = 0ull, unkT3 = 0ull;
+        uint32_t unkSeen[16] = {};
+        int unkSeenN = 0;
+        unsigned long long kicks = 0ull;
+        Vu1FlagBucket b[2];
+    };
+
+    // Namespace-scope (not function-local static) on purpose: these are read from the
+    // interpreter's hot path, and a function-local static would cost a guard-variable load on
+    // every flag op.  getenv has no static-init dependencies, so dynamic init here is safe.
+    const int g_vu1FlagCensusEvery = []
+    {
+        const char *e = std::getenv("PS2X_VU1_FLAGCENSUS");
+        return (e != nullptr && e[0] != '\0') ? std::atoi(e) : 0;
+    }();
+
+    const uint32_t g_vu1FlagCensusAddr = []
+    {
+        const char *e = std::getenv("PS2X_VU1_FLAGCENSUS_ADDR");
+        return (e != nullptr && e[0] != '\0')
+                   ? (uint32_t)std::strtoul(e, nullptr, 0)
+                   : 8272u;
+    }();
+
+    // Per-VU, for the same reason the kick census is (standing rule 22): VU0 and VU1 share
+    // this interpreter class.  Index by buffer size -- 4KB = VU0, 16KB = VU1.
+    Vu1FlagCensus &ps2xFlagCensusFor(uint32_t dataSize)
+    {
+        static Vu1FlagCensus s_c[2];
+        return s_c[(dataSize <= 4096u) ? 0 : 1];
+    }
+
+    inline void ps2xFlagOp(uint32_t dataSize, int op)
+    {
+        if (g_vu1FlagCensusEvery <= 0)
+            return;
+        ++ps2xFlagCensusFor(dataSize).ops[op];
+    }
+
+    // which: 0 = top-level lower opcode, 1 = LOWER1 funct, 2 = LOWER1 T3 funct2.
+    // An unimplemented opcode is a SILENT no-op in this interpreter (`default: return;`), so a
+    // microprogram relying on one gets a stale register and no diagnostic whatsoever.
+    inline void ps2xFlagUnknownOp(uint32_t dataSize, int which, uint32_t sel)
+    {
+        if (g_vu1FlagCensusEvery <= 0)
+            return;
+        Vu1FlagCensus &c = ps2xFlagCensusFor(dataSize);
+        if (which == 0)
+            ++c.unkLower;
+        else if (which == 1)
+            ++c.unkLower1;
+        else
+            ++c.unkT3;
+
+        const uint32_t key = ((uint32_t)which << 8) | (sel & 0xFFu);
+        for (int i = 0; i < c.unkSeenN; ++i)
+        {
+            if (c.unkSeen[i] == key)
+                return;
+        }
+        if (c.unkSeenN < 16)
+            c.unkSeen[c.unkSeenN++] = key;
+    }
+
+    void ps2xFlagCensusKick(uint32_t dataSize, uint64_t firstTag, bool haveTag, uint32_t addr,
+                            uint32_t clip, uint32_t mac, uint32_t status)
+    {
+        if (g_vu1FlagCensusEvery <= 0)
+            return;
+
+        Vu1FlagCensus &c = ps2xFlagCensusFor(dataSize);
+        const int vu = (dataSize <= 4096u) ? 0 : 1;
+        ++c.kicks;
+
+        const uint32_t nloop = haveTag ? (uint32_t)(firstTag & 0x7FFFull) : 0u;
+        Vu1FlagBucket &b = c.b[(nloop == 0u) ? 0 : 1];
+        ++b.kicks;
+        if (addr == g_vu1FlagCensusAddr)
+            ++b.atAddr;
+
+        // Attribute every flag op executed since the previous kick to THIS kick's bucket.
+        for (int i = 0; i < FOP_COUNT; ++i)
+        {
+            b.ops[i] += c.ops[i] - c.opsAtLastKick[i];
+            c.opsAtLastKick[i] = c.ops[i];
+        }
+
+        if (clip == 0u)
+            ++b.clipZero;
+        else if ((clip & 0xFFFFFFu) == 0xFFFFFFu)
+            ++b.clipFull;
+        else
+            ++b.clipOther;
+        if (mac != 0u)
+            ++b.macNonZero;
+        if (status != 0u)
+            ++b.statusNonZero;
+        b.lastClip = clip;
+        b.lastMac = mac;
+        b.lastStatus = status;
+
+        if (c.kicks <= 20ull || (c.kicks % (unsigned long long)g_vu1FlagCensusEvery) == 0ull)
+        {
+            char opsTotal[256];
+            int n = 0;
+            for (int i = 0; i < FOP_COUNT && n < (int)sizeof(opsTotal) - 1; ++i)
+                n += std::snprintf(opsTotal + n, sizeof(opsTotal) - (size_t)n, "%s=%llu ",
+                                   kVu1FlagOpName[i], (unsigned long long)c.ops[i]);
+
+            char unk[128];
+            int m = std::snprintf(unk, sizeof(unk), "lower=%llu lower1=%llu t3=%llu seen=[",
+                                  (unsigned long long)c.unkLower,
+                                  (unsigned long long)c.unkLower1,
+                                  (unsigned long long)c.unkT3);
+            for (int i = 0; i < c.unkSeenN && m < (int)sizeof(unk) - 8; ++i)
+                m += std::snprintf(unk + m, sizeof(unk) - (size_t)m, "%u:%02X ",
+                                   c.unkSeen[i] >> 8, c.unkSeen[i] & 0xFFu);
+            std::snprintf(unk + m, sizeof(unk) - (size_t)m, "]");
+
+            std::fprintf(stderr,
+                         "[VU1:flagcensus] vu%d #%llu | ops(all kicks): %s| unknown-ops: %s\n",
+                         vu, (unsigned long long)c.kicks, opsTotal, unk);
+
+            for (int k = 0; k < 2; ++k)
+            {
+                const Vu1FlagBucket &bk = c.b[k];
+                char per[256];
+                int p = 0;
+                for (int i = 0; i < FOP_COUNT && p < (int)sizeof(per) - 1; ++i)
+                    p += std::snprintf(per + p, sizeof(per) - (size_t)p, "%s=%llu ",
+                                       kVu1FlagOpName[i], (unsigned long long)bk.ops[i]);
+                std::fprintf(stderr,
+                             "[VU1:flagcensus]   %-8s kicks=%llu at%u=%llu | clip 0/FFFFFF/other="
+                             "%llu/%llu/%llu last=%06X | mac!=0=%llu last=%04X | status!=0=%llu "
+                             "last=%03X | ops: %s\n",
+                             (k == 0) ? "nloop0" : "nloopNZ",
+                             (unsigned long long)bk.kicks, g_vu1FlagCensusAddr,
+                             (unsigned long long)bk.atAddr,
+                             (unsigned long long)bk.clipZero, (unsigned long long)bk.clipFull,
+                             (unsigned long long)bk.clipOther, bk.lastClip,
+                             (unsigned long long)bk.macNonZero, bk.lastMac,
+                             (unsigned long long)bk.statusNonZero, bk.lastStatus, per);
+            }
+        }
+    }
+
+    // ========================================================================
+    // PS2X_VU_FLAGFIX (default 1 = ON; =0 restores the previous behaviour).
+    //
+    // The VU flag-op decode table below was WRONG in four slots and three of the FS* bodies
+    // were wrong outright.  Verified against PCSX2 `pcsx2/VUops.cpp` -- the authoritative
+    // `_LOWER_OPCODE[128]` table (`_vuTablesMess`) plus the `_vuFS*` / `_vuFM*` / `_vuFCGET`
+    // bodies:
+    //
+    //   opcode | PCSX2  | was              | defect
+    //   -------+--------+------------------+---------------------------------------------
+    //   0x14   | FSEQ   | FSEQ  -> VI01    | wrong dest (It) + wrong imm assembly
+    //   0x15   | FSSET  | FSSET            | wrong imm assembly; clobbered status[5:0]
+    //   0x16   | FSAND  | FSAND -> VI01    | wrong dest (It) + wrong imm assembly
+    //   0x17   | FSOR   | equality test    | wrong dest, wrong imm, WRONG OPERATION
+    //   0x18   | FMEQ   | FMAND            | swapped with 0x1A
+    //   0x1A   | FMAND  | FMEQ             | swapped with 0x18
+    //   0x1B   | FMOR   | (absent)         | silent no-op -- It left stale
+    //   0x1C   | FCGET  | FMOR             | wrong op: returned MAC, not the CLIP flags
+    //
+    // The FS* dest/imm defect is a REGRESSION: `patches/README.md` records it as fixed in
+    // cont.44 ("FSEQ/FSAND/FSOR write It"), but the fix is absent from both the current patch
+    // and upstream baseline ee149581 -- it was lost in the ee14958 toolchain migration and the
+    // README row was carried forward without re-verification.
+    //
+    // PCSX2 writes these results as `VI[_It_].US[0]`, i.e. 16-bit, so results are masked.
+    // Immediates for the FS* family are `(((code >> 21) & 1) << 11) | (code & 0x7FF)`.
+    //
+    // ⚠ NOTE (not fixed here, measured by the census above): `m_state.mac` is never COMPUTED
+    // anywhere in this interpreter -- no FMAC op updates it -- so FMEQ/FMAND/FMOR read a
+    // permanently-zero MAC register regardless of this fix.  See the flagcensus `mac!=0`
+    // column.
+    // ========================================================================
+    const bool g_vu1FlagFix = []
+    {
+        const char *e = std::getenv("PS2X_VU_FLAGFIX");
+        return !(e != nullptr && e[0] == '0');
+    }();
+
+    inline uint16_t vuFsImm(uint32_t instr)
+    {
+        return (uint16_t)((((instr >> 21) & 0x1u) << 11) | (instr & 0x7FFu));
+    }
+
+    // ========================================================================
+    // PS2X_VU1_KICKDUMP=<N> (default 0 = OFF): dump the bytes of a RUNAWAY SUBMIT.
+    // Cycle 91 item (b).  Diagnostic only.
+    //
+    // WHY: the DROP path already dumps bytes, but cont.144 established that the failing kicks
+    // overwhelmingly SUBMIT -- an `nloop=0, EOP=0` tag is a legal no-op, so the walk advances
+    // only 16 B per iteration and terminates at the ITERATION cap (255) having accumulated
+    // ~4 KB, which never trips the 16 KB byte guard.  So every byte-level fact we had about the
+    // failing tag came from a population (the drops) that is NOT the one reaching GS.
+    //
+    // "Runaway" here means the walk ended WITHOUT ever seeing EOP.  Dumps 64 B at `addr`: the
+    // 16 B tag plus the 48 B behind it, which is where cont.144 read real float vertex data.
+    // ========================================================================
+    const int g_vu1KickDumpEvery = []
+    {
+        const char *e = std::getenv("PS2X_VU1_KICKDUMP");
+        return (e != nullptr && e[0] != '\0') ? std::atoi(e) : 0;
+    }();
+
+    unsigned long long g_vu1RunawaySubmits[2] = {0ull, 0ull};
+} // namespace

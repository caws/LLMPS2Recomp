-        dst[3] = result[3]; // w
+        dst[3] = ps2xVuClampResult(result[3]); // w
 }
 
 void VU1Interpreter::applyDestAcc(const float *result, uint8_t dest)
 {
+    // EVERY caller of applyDestAcc is an ACC-writing FMAC op (ADDA/SUBA/MULA/MADDA/MSUBA and
+    // their bc/i/q forms, plus OPMULA), so the MAC update belongs here unconditionally -- unlike
+    // applyDest, which the lower pipeline also uses for MOVE/MR32/LQ*/MFIR/MFP.  Pre-clamp
+    // result, matching PCSX2's order.  See PS2X_VU_MACFLAGS in ps2_vu1_detail.h.
+    vuMacUpdateFmac(m_state.mac, m_state.status, result, dest);
     applyDest(m_state.acc, result, dest);
 }
 

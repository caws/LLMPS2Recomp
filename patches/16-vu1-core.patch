+// ---------------------------------------------------------------------------------------
+// PS2X_VU_CLAMP (default ON; =0 restores the old raw-IEEE behaviour).
+//
+// THE PS2 VU FPU HAS NO NaN, NO INFINITY AND NO DENORMALS -- every result is clamped. We
+// were using raw host IEEE floats, so an overflow or 0/0 produced a real NaN, NaN is
+// contagious through all downstream arithmetic, and FTOI of that NaN saturates to
+// 0x7FFFFFFF (INT_MAX). Stored into VU1 memory that word is later walked as a GIF tag
+// (flg=3, nreg=7), the tag walk runs away, and the packet is dropped -- i.e. missing /
+// garbage geometry.
+//
+// MEASURED (cycle 89, paired in/out census around the same invocation): in the LEVEL era
+// 24 of 24 sampled invocations RAISED both counts across run() -- e.g. nan 805->1024 (all
+// of VU1 memory) and ftoi-sat 404->519 -- while 0 of 20 boot-era pairs changed. The
+// microprogram was manufacturing the NaN, not receiving it. Entry-NaN median rose 48
+// (boot) -> 719 (level) as it accumulated across invocations.
+//
+// PCSX2 reference: `vuDouble()` in pcsx2/VUops.cpp --
+//     exponent 0x00 (denormal) -> flush to SIGNED ZERO   (f &= 0x80000000)
+//     exponent 0xFF (Inf/NaN)  -> +/- MAX FLOAT          ((f & 0x80000000) | 0x7f7fffff)
+// and DIV/RSQRT by zero -> `VU->q.UL = 0x7F7FFFFF` (our DIV/RSQRT already did this).
+//
+// ⚠ KNOWN DIVERGENCE, deliberate: PCSX2 applies vuDouble() when READING each operand; we
+// apply it when WRITING each result. Clamping writes keeps NaN out of registers and out of
+// VU memory (the measured failure mode) at 2 chokepoints instead of every operand read.
+// A value that is already NaN in VU memory before this fix would still be read raw here,
+// where PCSX2 would clamp it on load. Revisit if a case turns up that needs read-side
+// clamping.
+static inline float ps2xVuClampResult(float v)
+{
+    static const bool s_on = [] {
+        const char *e = std::getenv("PS2X_VU_CLAMP");
+        return !(e != nullptr && e[0] == '0');
+    }();
+    if (!s_on)
+        return v;
+    uint32_t f;
+    std::memcpy(&f, &v, 4);
+    switch (f & 0x7F800000u)
+    {
+        case 0x00000000u:                       // denormal -> signed zero
+            f &= 0x80000000u;
+            break;
+        case 0x7F800000u:                       // Inf / NaN -> +/- max float
+            f = (f & 0x80000000u) | 0x7F7FFFFFu;
+            break;
+        default:
+            return v;
+    }
+    float out;
+    std::memcpy(&out, &f, 4);
+    return out;
+}

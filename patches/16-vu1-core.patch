+// PS2X_VU1_MEMCENSUS=<N> (default 0 = OFF): every Nth microprogram start, census VU1 data
+// memory BEFORE the program runs. Diagnostic only -- reads nothing, changes nothing.
+//
+// WHY: the [VU1:xgkick] DROP line already censuses VU1 memory, but only AT XGKICK and only
+// when a runaway tag walk fires -- i.e. samples conditioned on failure, after execution. That
+// cannot distinguish the two upstream causes it matters to separate (cycle 89):
+//   (a) VU1 memory ARRIVES with NaN  -> the VIF upload / source data is bad
+//   (b) the microprogram COMPUTES NaN -> bad inputs to the program, or our VU arithmetic
+// Sampling at entry vs at XGKICK separates them: entry-NaN ~= XGKICK-NaN means (a); entry
+// clean and XGKICK dirty means (b).
+//
+// Measured baselines to compare against (level era, DROP-conditioned, of 1024 qw):
+//   c86C rendered TERRAIN: nan_qw median 143 | c88A noise: median 369 | c87B: saturates 1024
+static void ps2xVu1MemCensus(const uint8_t *vuData, uint32_t dataSize, uint32_t startPC,
+                             const char *how)
+{
+    static const int s_every = [] {
+        const char *e = std::getenv("PS2X_VU1_MEMCENSUS");
+        return (e != nullptr && e[0] != '\0') ? std::atoi(e) : 0;
+    }();
+    if (s_every <= 0 || vuData == nullptr)
+        return;
+    // Log the FIRST 20 as well as every Nth. Without the first-20 window a low call count is
+    // indistinguishable from "never called" -- which cost a rebuild here: 13 XGKICK drops with
+    // 0 census lines read as a mis-placed probe, when the interval simply had not elapsed.
+    // (Same first-N-then-every-Nth shape the [VU1:xgkick] DROP logger uses.)
+    // PER-VU counters. VU0 and VU1 share this interpreter class (m_vu0.execute() runs the
+    // same code with a 4KB buffer), so ONE shared counter let VU0's 65 boot-era invocations
+    // consume the first-20 window and yielded only 2 VU1 samples -- none of them the FIRST
+    // VU1 invocation, which is exactly the sample needed to tell "arrived bad" from "left
+    // over from a previous run of the program". Index by buffer size: 4KB = VU0, 16KB = VU1.
+    const int vu = (dataSize <= 4096u) ? 0 : 1;
+    static unsigned long long s_calls[2] = {0ull, 0ull};
+    static bool s_pairArmed[2] = {false, false};
+    const bool isIn = (how[std::strlen(how) - 1] == 'n');
+    unsigned long long n;
+    if (isIn)
+    {
+        n = ++s_calls[vu];
+        s_pairArmed[vu] = (n <= 20ull || (n % static_cast<unsigned long long>(s_every)) == 0ull);
+        if (!s_pairArmed[vu])
+            return;
+    }
+    else
+    {
+        // the matching "-out" always logs iff its "-in" did, so every sample is a PAIR
+        if (!s_pairArmed[vu])
+            return;
+        n = s_calls[vu];
+    }
+
+    const uint32_t totalQw = dataSize / 16u;
+    uint32_t nanQw = 0u, zeroQw = 0u, satQw = 0u;
+    for (uint32_t q = 0; q < totalQw; ++q)
+    {
+        uint32_t w[4];
+        std::memcpy(w, vuData + q * 16u, 16);
+        int nans = 0, zeros = 0, sats = 0;
+        for (int c = 0; c < 4; ++c)
+        {
+            if (((w[c] >> 23) & 0xFFu) == 0xFFu)
+                ++nans;
+            if (w[c] == 0u)
+                ++zeros;
+            // 0x7FFFFFFF is the FTOI saturation result -- the value found sitting in the
+            // malformed GIF tags of the noise runs (c88A tag word1 = 7FFFFFFF -> flg=3).
+            if (w[c] == 0x7FFFFFFFu || w[c] == 0x80000000u)
+                ++sats;
+        }
+        if (nans > 0)
+            ++nanQw;
+        if (zeros == 4)
+            ++zeroQw;
+        if (sats > 0)
+            ++satQw;
+    }
+    std::fprintf(stderr,
+                 "[VU1:memcensus] VU%d #%llu %s startPC=%u nan/inf qw=%u zero qw=%u ftoi-sat qw=%u of %u\n",
+                 vu, (unsigned long long)n, how, startPC, nanQw, zeroQw, satQw, totalQw);
+}
 

diff --git a/ps2xRuntime/src/lib/ps2_gs_gpu.cpp b/ps2xRuntime/src/lib/ps2_gs_gpu.cpp
index f1f2bde..d983a10 100644
--- a/ps2xRuntime/src/lib/ps2_gs_gpu.cpp
+++ b/ps2xRuntime/src/lib/ps2_gs_gpu.cpp
@@ -1776,14 +1800,23 @@ void GS::writeRegister(uint8_t regAddr, uint64_t value)
     case GS_REG_PRIM:
     {
         m_prim.type = static_cast<GSPrimType>(value & 0x7);
-        m_prim.iip = ((value >> 3) & 1) != 0;
-        m_prim.tme = ((value >> 4) & 1) != 0;
-        m_prim.fge = ((value >> 5) & 1) != 0;
-        m_prim.abe = ((value >> 6) & 1) != 0;
-        m_prim.aa1 = ((value >> 7) & 1) != 0;
-        m_prim.fst = ((value >> 8) & 1) != 0;
-        m_prim.ctxt = ((value >> 9) & 1) != 0;
-        m_prim.fix = ((value >> 10) & 1) != 0;
+        // PCSX2 GSState::ApplyPRIM: when PRMODECONT.AC == 0 a PRIM write applies ONLY the
+        // primitive type (`m_env.PRIM.PRIM = prim & 0x7`) — the attribute flags
+        // (IIP/TME/FGE/ABE/AA1/FST/CTXT/FIX) are owned by PRMODE while in PRMODE mode.
+        // Unconditionally overwriting them here let every GIFtag PRE PRIM (e.g. the LOTR
+        // quad emitter's plain PRIM=4 tristrip tag) strip TME/ABE set via PRMODE=0x58,
+        // rendering textured passes flat.
+        if (m_prmodecont)
+        {
+            m_prim.iip = ((value >> 3) & 1) != 0;
+            m_prim.tme = ((value >> 4) & 1) != 0;
+            m_prim.fge = ((value >> 5) & 1) != 0;
+            m_prim.abe = ((value >> 6) & 1) != 0;
+            m_prim.aa1 = ((value >> 7) & 1) != 0;
+            m_prim.fst = ((value >> 8) & 1) != 0;
+            m_prim.ctxt = ((value >> 9) & 1) != 0;
+            m_prim.fix = ((value >> 10) & 1) != 0;
+        }
         m_vtxCount = 0;
         m_vtxIndex = 0;
         break;

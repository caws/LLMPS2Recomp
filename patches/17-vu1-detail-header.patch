@@ -2,6 +2,133 @@
 #define PS2_VU1_DETAIL_H
 
 #include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+// ============================================================================
+// PS2X_VU_MACFLAGS (default ON; =0 restores the pre-cycle-92 behaviour, i.e. a MAC register
+// that is never written).
+//
+// THE MAC FLAG REGISTER WAS NEVER COMPUTED.  Nothing in this interpreter wrote `m_state.mac`
+// -- it was only ever READ, by FMEQ/FMAND/FMOR, and copied to/from the VU0 macro-mode context.
+// So every MAC test in a microprogram read a permanently-zero register.  Measured in cycle 91
+// (`PS2X_VU1_FLAGCENSUS`): `mac != 0` on ZERO of ~1.07M censused kicks, while the level-era
+// microprogram executed **41,069,286** `fmand` ops -- 33.7M of them on kicks whose first GIF
+// tag carried `nloop == 0`, at 146x the per-kick rate of the known-good bucket.
+//
+// Mirrors PCSX2 `pcsx2/VUflags.cpp`: `VU_MAC_UPDATE` (per component), `VU_MACx_CLEAR` (for
+// components OUTSIDE the dest mask) and `VU_STAT_UPDATE` (STATUS as an OR-reduction of MAC).
+// Per-component shifts are x=3, y=2, z=1, w=0, and the four flag groups are:
+//     0x0001 << s   Z  zero
+//     0x0010 << s   S  sign
+//     0x0100 << s   U  underflow (denormal)
+//     0x1000 << s   O  overflow  (Inf / NaN)
+//
+// ⚠ Flags are computed from the RAW, PRE-CLAMP result, exactly as PCSX2 does -- its
+// `VU_MAC_UPDATE` sets the flags and *then* returns the clamped value.  So an overflow still
+// registers as O even though `PS2X_VU_CLAMP` goes on to store +-MAX_FLOAT.  Computing them
+// after the clamp would silently lose every O and U flag, which are the interesting ones.
+//
+// ⚠ Applies to the TRUE FMAC ARITHMETIC OPS ONLY.  Verified against PCSX2: MAX/MINI
+// (`applyMinMax`), ABS/ITOF/FTOI (`applyUnaryFunction`), MOVE, MR32, LQ*/SQ*, MFIR, MFP and
+// CLIP do NOT touch MAC.  Do not hook `applyDest` blanket-wise -- the lower pipeline uses it.
+// ============================================================================
+inline const bool g_vuMacFlagsEnabled = []
+{
+    const char *e = std::getenv("PS2X_VU_MACFLAGS");
+    return !(e != nullptr && e[0] == '0');
+}();
+
+static inline void vuMacUpdateComponent(uint32_t &macflag, int shift, float f)
+{
+    uint32_t v;
+    std::memcpy(&v, &f, 4);
+    const int exp = (int)((v >> 23) & 0xFFu);
+    const uint32_t sign = v & 0x80000000u;
+
+    if (sign != 0u)
+        macflag |= (uint32_t)(0x0010u << shift);
+    else
+        macflag &= ~(uint32_t)(0x0010u << shift);
+
+    if (f == 0.0f)
+    {
+        macflag = (macflag & ~(uint32_t)(0x1100u << shift)) | (uint32_t)(0x0001u << shift);
+        return;
+    }
+
+    if (exp == 0)
+        macflag = (macflag & ~(uint32_t)(0x1000u << shift)) | (uint32_t)(0x0101u << shift);
+    else if (exp == 255)
+        macflag = (macflag & ~(uint32_t)(0x0101u << shift)) | (uint32_t)(0x1000u << shift);
+    else
+        macflag &= ~(uint32_t)(0x1101u << shift);
+}
+
+// PCSX2 `VU_STAT_UPDATE`.  NOTE: its own comment says it preserves the sticky flags and the
+// D/I bits, but the code plainly assigns `newflag`; we mirror the CODE, not the comment.
+static inline void vuStatUpdate(uint32_t macflag, uint32_t &statusflag)
+{
+    uint32_t newflag = 0u;
+    if (macflag & 0x000Fu)
+        newflag = 0x1u;
+    if (macflag & 0x00F0u)
+        newflag |= 0x2u;
+    if (macflag & 0x0F00u)
+        newflag |= 0x4u;
+    if (macflag & 0xF000u)
+        newflag |= 0x8u;
+    statusflag = newflag;
+}
+
+// dest bit layout in this interpreter: 0x8 = x, 0x4 = y, 0x2 = z, 0x1 = w.
+static inline void vuMacUpdateFmac(uint32_t &macflag, uint32_t &statusflag,
+                                   const float *result, uint8_t dest)
+{
+    if (!g_vuMacFlagsEnabled)
+        return;
+
+    static const int kShift[4] = {3, 2, 1, 0};
+    static const uint8_t kDestBit[4] = {0x8u, 0x4u, 0x2u, 0x1u};
+
+    for (int c = 0; c < 4; ++c)
+    {
+        if ((dest & kDestBit[c]) != 0u)
+            vuMacUpdateComponent(macflag, kShift[c], result[c]);
+        else
+            macflag &= ~(uint32_t)(0x1111u << kShift[c]); // VU_MACx_CLEAR
+    }
+
+    vuStatUpdate(macflag, statusflag);
+}
+
+// FTOI float->fixed conversion.
+//
+// The VU saturates out-of-range results; a plain C cast does NOT.  `(int32_t)f` for an f
+// outside int32 range (or NaN) is undefined behaviour, and on x86 SSE (cvttss2si) it yields
+// the "integer indefinite" value 0x80000000 for EVERY out-of-range input -- including
+// positive ones.  Vertices near/behind the camera (huge q from DIV) therefore all collapsed
+// onto one sign-flipped coordinate instead of clamping to the screen edge, which is what
+// produced the streaked triangles radiating from a single point.
+//
+// Mirrors PCSX2 pcsx2/VUops.cpp `floatToInt<Offset>()`.
+static inline uint32_t vuFloatToInt(float f, uint32_t offset)
+{
+    uint32_t uvalue;
+    if (offset != 0u)
+    {
+        const uint32_t scaleBits = 0x3F800000u + (offset << 23); // 2^offset
+        float scale;
+        std::memcpy(&scale, &scaleBits, 4);
+        f *= scale;
+    }
+    std::memcpy(&uvalue, &f, 4);
+
+    if ((uvalue & 0x7F800000u) >= 0x4F000000u) // |f| >= 2^31, or Inf/NaN
+        return (uvalue & 0x80000000u) ? 0x80000000u : 0x7FFFFFFFu;
+
+    return static_cast<uint32_t>(static_cast<int32_t>(f));
+}
 
 // Instruction field extraction helpers
 static inline uint8_t DEST(uint32_t i) { return (uint8_t)((i >> 21) & 0xF); }

+    EGLContext context = EGL_NO_CONTEXT;
+    EGLSurface surface = EGL_NO_SURFACE; // pbuffer fallback only
+    GlApi gl{};
+    GLuint program = 0;
+    GLuint vramBuf = 0; // phase-0 present-snapshot buffer (upload cache per sourceId)
+    GLuint tabBuf = 0;
+    GLuint outBuf = 0;

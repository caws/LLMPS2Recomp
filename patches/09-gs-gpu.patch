+// PS2X_GS_CENSUS=<path>            enable the census and write it here (unset => wholly inert)
+// PS2X_GS_CENSUS_AT=<frame>        first debug-frame index to record         (default 0)
+// PS2X_GS_CENSUS_FRAMES=<n>        how many frames to record                 (default 2)
+// PS2X_GS_CENSUS_KINDS=<mask>      bitmask over GSDebugEventKind             (default 0x1C =
+//                                  Draw|Transfer|Present; 0x1F adds GifTag+Register)
+// PS2X_GS_CENSUS_EVERY=<k>         PERIODIC mode: record FRAMES out of every k frames, forever
+//                                  (default 0 = one contiguous window, then close)
+// PS2X_GS_CENSUS_MAX=<lines>       hard cap on emitted lines                 (default 4000000)
+//
+// Why PERIODIC mode exists: the interesting frames are ~15 min into the boot (post-FMV gameplay),
+// and the debug frame index is NOT the game's own frame counter (`c=` at [gp+0x1b9c]) nor the
+// wall-clock vsync tick -- it only advances when a GS event observes a *changed* vsync tick, so a
+// GS-quiet stretch makes the two diverge by an unknowable amount. There is therefore no way to
+// pick PS2X_GS_CENSUS_AT in advance. Sampling FRAMES-out-of-every-k covers the whole run instead,
+// bounded by _MAX, and the `F` marker lines make the file trivially segmentable per frame.
+void GS::initDebugCensusUnlocked()
+{
+    m_censusChecked = true;
+
+    const char *path = std::getenv("PS2X_GS_CENSUS");
+    if (path == nullptr || path[0] == '\0')
+    {
+        return;
+    }
+
+    const auto envU32 = [](const char *name, uint32_t dflt) -> uint32_t {
+        const char *v = std::getenv(name);
+        if (v == nullptr || v[0] == '\0')
+        {
+            return dflt;
+        }
+        return static_cast<uint32_t>(std::strtoul(v, nullptr, 0));
+    };
+
+    m_censusStartFrame = envU32("PS2X_GS_CENSUS_AT", 0u);
+    m_censusFrameCount = envU32("PS2X_GS_CENSUS_FRAMES", 2u);
+    m_censusKindMask = envU32("PS2X_GS_CENSUS_KINDS", 0x1Cu);
+    m_censusEvery = envU32("PS2X_GS_CENSUS_EVERY", 0u);
+    m_censusMaxLines = envU32("PS2X_GS_CENSUS_MAX", 4000000u);
+
+    m_censusFile = std::fopen(path, "w");
+    if (m_censusFile == nullptr)
+    {
+        std::fprintf(stderr, "[GS:census] FAILED to open '%s'\n", path);
+        return;
+    }
+
+    // Capture is paused by default (only the ImGui panel un-pauses it), so the census must
+    // un-pause it itself or no event would ever reach recordDebugEventUnlocked.
+    m_debugHistoryPaused = false;
+
+    std::fprintf(stderr, "[GS:census] -> %s  at=%u frames=%u kinds=0x%02X every=%u max=%u\n",
+                 path, m_censusStartFrame, m_censusFrameCount, m_censusKindMask,
+                 m_censusEvery, m_censusMaxLines);
+    std::fprintf(m_censusFile,
+                 "# F frameIndex tick            (frame-boundary marker: every line below it is that frame)\n"
+                 "# PS2X_GS_CENSUS at=%u frames=%u kinds=0x%02X\n"
+                 "# D seq frame tick prim iip tme fge abe fst ctxt | fbp fbw fpsm | zbp zpsm zmsk |"
+                 " test alpha | tbp tpsm tw th cbp | nv | xMin xMax yMin yMax zMin zMax aMin aMax\n"
+                 "# T seq frame tick | dbp dbw dpsm | sbp sbw spsm | ssax ssay dsax dsay dir |"
+                 " rrw rrh | trxdir pixels\n"
+                 "# P seq frame tick | displayFbp sourceFbp w h usedPreferred\n"
+                 "# G seq frame tick | sizeBytes nloop flg nreg\n"
+                 "# R seq frame tick | reg value\n",
+                 m_censusStartFrame, m_censusFrameCount, m_censusKindMask);
+}
+
+void GS::emitDebugCensusUnlocked(const GSDebugHistoryEntry &e)
+{
+    if (m_censusFile == nullptr)
+    {
+        return;
+    }
+    if ((m_censusKindMask & (1u << static_cast<uint32_t>(e.kind))) == 0u)
+    {
+        return;
+    }
+    if (e.frameIndex < m_censusStartFrame)
+    {
+        return;
+    }
+
+    const auto closeCensus = [this](const char *why) {
+        std::fprintf(stderr, "[GS:census] %s, %llu lines\n", why,
+                     static_cast<unsigned long long>(m_censusLines));
+        std::fclose(m_censusFile);
+        m_censusFile = nullptr;
+    };
+
+    if (m_censusEvery > 0u)
+    {
+        // PERIODIC: record m_censusFrameCount frames out of every m_censusEvery, never auto-close.
+        if (((e.frameIndex - m_censusStartFrame) % m_censusEvery) >= m_censusFrameCount)
+        {
+            return;
+        }
+    }
+    else if (e.frameIndex >= m_censusStartFrame + m_censusFrameCount)
+    {
+        closeCensus("window done");
+        return;
+    }
+
+    if (m_censusLines >= m_censusMaxLines)
+    {
+        closeCensus("line cap reached");
+        return;
+    }
+
+    // Frame-boundary marker so the file segments per frame without re-deriving it from `seq`.
+    if (e.frameIndex != m_censusLastEmittedFrame)
+    {
+        m_censusLastEmittedFrame = e.frameIndex;
+        std::fprintf(m_censusFile, "F\t%u\t%llu\n", e.frameIndex,
+                     static_cast<unsigned long long>(e.vsyncTick));
+    }
+
+    ++m_censusLines;
+
+    switch (e.kind)
+    {
+    case GSDebugEventKind::Draw:
+        std::fprintf(m_censusFile,
+                     "D\t%llu\t%u\t%llu\t%u\t%u %u %u %u %u %u\t%u %u 0x%02X\t%u 0x%02X %u\t"
+                     "0x%llX\t0x%llX\t%u 0x%02X %u %u %u\t%u\t%.2f %.2f %.2f %.2f\t%.1f %.1f\t%u %u\n",
+                     static_cast<unsigned long long>(e.seq), e.frameIndex,
+                     static_cast<unsigned long long>(e.vsyncTick),
+                     static_cast<unsigned int>(e.prim.type),
+                     e.prim.iip ? 1u : 0u, e.prim.tme ? 1u : 0u, e.prim.fge ? 1u : 0u,
+                     e.prim.abe ? 1u : 0u, e.prim.fst ? 1u : 0u, e.prim.ctxt ? 1u : 0u,
+                     e.frame.fbp, static_cast<unsigned int>(e.frame.fbw),
+                     static_cast<unsigned int>(e.frame.psm),
+                     e.zbuf.zbp, static_cast<unsigned int>(e.zbuf.psm), e.zbuf.zmask ? 1u : 0u,
+                     static_cast<unsigned long long>(e.test),
+                     static_cast<unsigned long long>(e.alpha),
+                     e.tex0.tbp0, static_cast<unsigned int>(e.tex0.psm),
+                     1u << e.tex0.tw, 1u << e.tex0.th, e.tex0.cbp,
+                     e.vertexCount,
+                     e.xMin, e.xMax, e.yMin, e.yMax,
+                     e.zMin, e.zMax,
+                     static_cast<unsigned int>(e.aMin), static_cast<unsigned int>(e.aMax));
+        break;
+
+    case GSDebugEventKind::Transfer:
+        std::fprintf(m_censusFile,
+                     "T\t%llu\t%u\t%llu\t%u %u 0x%02X\t%u %u 0x%02X\t%u %u %u %u %u\t%u %u\t%u %u\n",
+                     static_cast<unsigned long long>(e.seq), e.frameIndex,
+                     static_cast<unsigned long long>(e.vsyncTick),
+                     e.bitbltbuf.dbp, static_cast<unsigned int>(e.bitbltbuf.dbw),
+                     static_cast<unsigned int>(e.bitbltbuf.dpsm),
+                     e.bitbltbuf.sbp, static_cast<unsigned int>(e.bitbltbuf.sbw),
+                     static_cast<unsigned int>(e.bitbltbuf.spsm),
+                     static_cast<unsigned int>(e.trxpos.ssax), static_cast<unsigned int>(e.trxpos.ssay),
+                     static_cast<unsigned int>(e.trxpos.dsax), static_cast<unsigned int>(e.trxpos.dsay),
+                     static_cast<unsigned int>(e.trxpos.dir),
+                     static_cast<unsigned int>(e.trxreg.rrw), static_cast<unsigned int>(e.trxreg.rrh),
+                     e.trxdir, e.transferPixels);
+        break;
+
+    case GSDebugEventKind::Present:
+        std::fprintf(m_censusFile, "P\t%llu\t%u\t%llu\t%u %u %u %u %u\n",
+                     static_cast<unsigned long long>(e.seq), e.frameIndex,
+                     static_cast<unsigned long long>(e.vsyncTick),
+                     e.displayFbp, e.sourceFbp, e.width, e.height, e.usedPreferred ? 1u : 0u);
+        break;
+
+    case GSDebugEventKind::GifTag:
+        std::fprintf(m_censusFile, "G\t%llu\t%u\t%llu\t%u %u %u %u\n",
+                     static_cast<unsigned long long>(e.seq), e.frameIndex,
+                     static_cast<unsigned long long>(e.vsyncTick),
+                     e.gifSizeBytes, e.gifNloop,
+                     static_cast<unsigned int>(e.gifFlg), static_cast<unsigned int>(e.gifNreg));
+        break;
+
+    case GSDebugEventKind::Register:
+        std::fprintf(m_censusFile, "R\t%llu\t%u\t%llu\t0x%02X 0x%llX\n",
+                     static_cast<unsigned long long>(e.seq), e.frameIndex,
+                     static_cast<unsigned long long>(e.vsyncTick),
+                     static_cast<unsigned int>(e.reg),
+                     static_cast<unsigned long long>(e.regValue));
+        break;
+    }
+}

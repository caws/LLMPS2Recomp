# PS2Recomp engine — stateless. Games live in separate per-game repos that this
# engine is pointed at; nothing game-specific is tracked here.

# Toolchain: each game's PS2Recomp clone lives IN the game repo, <game_dir>/.toolchain/PS2Recomp
# (scripts/01_setup.sh, scripts/_toolchain.sh). tools/<game>/PS2Recomp is the LEGACY location,
# still used where a clone exists there (rotk_recomp).
/tools/*/
/tools/ghidra*

# Scratch (build logs, run logs)
/tmp

# Editor / OS noise
*.swp
*~
.DS_Store
.idea/
.vscode/
sccache.log
/.claude/skills/ps2recomp-fix-next-crash/__*
__pycache__/

# Dear ImGui window layout, written by debug tools run from here
imgui.ini
